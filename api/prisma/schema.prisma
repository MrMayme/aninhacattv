generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  twitchId  String   @unique
  username  String
  email     String?
  avatar    String?

  createdAt DateTime @default(now())

  logins        LoginHistory[]
  twitchToken   TwitchToken?
  chatSessions  ChatSession[]

  @@map("user")  // Nome da tabela em minúsculas
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  loggedAt  DateTime @default(now())
  ip        String?  // opcional
  userAgent String? // opcional

  user User @relation(fields: [userId], references: [id])

  @@index([userId])

  @@map("loginhistory")  // Nome da tabela em minúsculas
}

enum TwitchTokenType {
  BROADCASTER
  BOT
  USER
}

model TwitchToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  type         TwitchTokenType @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("twitchtoken")  // Nome da tabela em minúsculas
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  channel   String

  startedAt DateTime
  endedAt   DateTime? // null = sessão ativa
  messageCount Int      @default(0)

  user User @relation(fields: [userId], references: [id])

  @@index([channel])
  @@index([userId])
  @@index([channel, endedAt])

  @@map("chatsession")  // Nome da tabela em minúsculas
}